# =============================================================================
# HYPERCROSS ENVIRONMENT CONFIGURATION
# Placeholders only. Never commit real credentials. Labels below indicate
# where each variable is consumed:
#   [SERVER ONLY]  Never sent to the browser or Electron bundle.
#   [PUBLIC]       Safe to expose in the browser build (VITE_ prefix).
#   [DESKTOP]      Consumed by the Electron main process at runtime.
#   [DEVELOPMENT]  Only relevant for local development.
# =============================================================================

# ── Runtime ── [SERVER ONLY]
NODE_ENV="development"
PORT="10000"
LOG_LEVEL="info"

# ── Public URLs ──
# [PUBLIC] Base URL the browser build uses to reach the protected API.
VITE_HYPERCROSS_API_URL="http://localhost:10000"
# [PUBLIC] WebSocket base URL for live Hypercross updates.
VITE_HYPERCROSS_WS_URL="ws://localhost:10000"
# [DESKTOP] Base URL the Electron app uses to reach the protected API.
HYPERCROSS_API_URL="http://localhost:10000"
# [DESKTOP] WebSocket base URL the Electron app uses for live updates.
HYPERCROSS_WS_URL="ws://localhost:10000"
# [SERVER ONLY] Canonical public web URL, used to build Stripe redirect URLs.
HYPERCROSS_PUBLIC_URL="http://localhost:5173"
# APP_URL: legacy alias kept for backward compatibility with existing code paths.
APP_URL="http://localhost:10000"
APP_BASE_URL="http://localhost:3000"

# ── Password recovery email ── [SERVER ONLY]
# Required in production. The adapter sends a JSON request to this provider URL.
EMAIL_PROVIDER_URL="gmail.googleapis.com"
EMAIL_PROVIDER_API_KEY=""

# ── CORS ── [SERVER ONLY]
# Comma-separated list of allowed browser origins. Never use "*" with credentials.
ALLOWED_ORIGINS="http://localhost:10000,https://hypercross-crypto-fire-rose-cross-nexus.onrender.com,https://hypercross-nexus-0-gold-augmentation.onrender.com,https://hypercross-nexus-gold.vercel.app,https://hypercross-nexus-gold-az-apex.vercel.app,https://www.hypercrossfinancial.online,https://hypercrossfinancial.online,https://www.hypercrossfinancial.com,https://hypercrossfinancial.com"

# ── PostgreSQL (production account/platform database) ── [SERVER ONLY]
# REQUIRED in production. Local SQLite remains available for local-only dev
# (see src/db/index.ts) but must never be used as the commercial database.
DATABASE_URL=""
PG_POOL_MAX="10"

# ── Auth secrets ── [SERVER ONLY] — generate strong random values, never reuse examples.
JWT_SECRET=""
ENCRYPTION_KEY=""

# ── Primary blockchain provider ── [SERVER ONLY unless noted]
BLOCKCHAIN_PROVIDER="chainstack"

# Chainstack network configuration
CHAINSTACK_NETWORK="base"
# [SERVER ONLY] Never expose in API responses, logs, or any client bundle.
CHAINSTACK_RPC_URL="https://your-chainstack-rpc-endpoint"
# [SERVER ONLY] Optional: enables subscription/event functionality only. HTTPS
# above is the primary transport and connectivity does not depend on this.
CHAINSTACK_WSS_URL="wss://your-chainstack-websocket-endpoint"
CHAINSTACK_CHAIN_ID="8453"
CHAINSTACK_API_KEY=""
CHAINSTACK_PROJECT_ID=""
CHAINSTACK_NODE_ID=""
# Leave empty for MVP: server-side signing is disabled by default and read-only
# RPC connectivity does not require a private key or wallet address.
CHAINSTACK_PRIVATE_KEY=""
CHAINSTACK_WALLET_ADDRESS=""
CHAINSTACK_NATIVE_CURRENCY="ETH"
CHAINSTACK_RPC_TIMEOUT_MS="15000"

# Live feed strict mode: when true, do not silently fall back to demo data
LIVE_FEED_STRICT="true"

# Standardized application data mode: "live", "demo", or "test"
# In live mode + LIVE_FEED_STRICT=true, blockchain data never silently falls back to demo data.
# Default is "live". To enable demo mode, both APP_DATA_MODE="demo" and ALLOW_DEMO_DATA="true" must be set.
APP_DATA_MODE="live"
ALLOW_DEMO_DATA="false"

# Safety and real execution tests configuration
ALLOW_MAINNET_WRITES="false"
RUN_REAL_EXECUTION_TESTS="false"

# Mainnet execution interlock: mainnet READS are always allowed. Mainnet WRITES
# (transfers, approvals, swaps, contract writes) are rejected with
# MAINNET_EXECUTION_DISABLED unless ALLOW_MAINNET is explicitly set to true.
ALLOW_MAINNET="false"

# Server-side signing is disabled by default. Only enable for automation —
# normal user transfers/approvals/swaps are always signed by the user's wallet.
ENABLE_SERVER_SIGNER="false"

# Debug/raw RPC passthrough endpoints are not implemented in this MVP; reserved
# flag so any future debug tooling defaults to disabled in production.
ENABLE_DEBUG_RPC="false"

# 0x Swap API key (https://0x.org/docs/api) — required for real swap quotes. [SERVER ONLY]
ZEROX_API_KEY=""

# ── Stripe (commercial billing) ── [SERVER ONLY] never expose to browser/desktop.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_RESEARCH=""
STRIPE_PRICE_TRADER=""
STRIPE_PRICE_PRO=""

# ── PayPal (commercial billing) ── [SERVER ONLY] never expose to browser/desktop.
# Required when paypal feature is enabled
PAYPAL_WEBHOOK_SECRET=""

# Public application URL used for Stripe Checkout success and cancellation redirects.
HYPERCROSS_PUBLIC_URL="https://your-domain.example"

# Feature flags for non-MVP modules. The operational MVP is: Dashboard, Wallet,
# Portfolio, Send, Swap, Transactions, Networks, Settings. Everything below
# defaults to enabled ("Coming Soon" in the UI) and their demo-data API routes
# return 404 while disabled.
FEATURE_RWA="false"
FEATURE_NFT="false"
FEATURE_LAUNCHPAD="false"
FEATURE_COPY_TRADING="false"
FEATURE_SPORTS="false"
FEATURE_DERIVATIVES="false"
FEATURE_MINING="false"
FEATURE_BANKING="true"
FEATURE_CUSTODY="false"

# [PUBLIC] Legacy Kaleido Hyperledger Fabric portal. Default false — the portal
# is not part of the MVP. When true, the UI shows a deprecation notice only;
# /api/kaleido and /api/fabric-* routes remain unimplemented (501).
VITE_ENABLE_LEGACY_KALEIDO_PORTAL="false"

# If you still need a legacy compatibility alias, keep it disabled by default.
LEGACY_BLOCKCHAIN_PROVIDER=""


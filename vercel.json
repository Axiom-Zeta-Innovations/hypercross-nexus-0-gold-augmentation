{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hypercross-nexus-0-gold-augmentation.onrender.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://hypercross-nexus-0-gold-augmentation.onrender.com/health/:path*"
    }
  ]
}
